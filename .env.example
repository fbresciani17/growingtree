# URL del tuo progetto Supabase (es. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Chiave anonima/pubblica di Supabase (anon key o publishable key)
# NON inserire mai la Secret / Service Role key!
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key-here

# Codice segreto di famiglia per abilitare le modifiche (es. PIN o parola d'ordine)
VITE_FAMILY_CODE=1234
